# Local development only. Copy to .env.local.
# These Mock settings are not a production deployment configuration.
EHS_DATA_SOURCE=mock
EHS_IDENTITY_MODE=mock
EHS_MOCK_PROFILE=standard
EHS_MOCK_USER_EMAIL=admin@example.test

# Optional: exact trusted parent origin for enterprise embedding (scheme + host + port).
# Leave empty for standalone development. Never use a wildcard.
NEXT_PUBLIC_GLIFE_PARENT_ORIGIN=

# Monitoring: comma-separated recipients; empty means notification routing is unconfigured.
EHS_MONITORING_ALERT_RECIPIENTS=
EHS_MONITORING_NOTIFY_WARNINGS=false
EHS_MONITORING_CLIENT_REPORT_LIMIT_PER_MINUTE=20
# Absolute application URL used in monitoring notification links.
EHS_APP_URL=http://localhost:3000
# Empty array schedules no job checks; an external scheduler is still required.
# Each job needs jobId, jobName, firstExpectedAt, expectedIntervalMs,
# allowedDelayMs, maxRuntimeMs and maxHeartbeatAgeMs. See Monitoring V1 docs.
EHS_MONITORING_JOBS=[]
# Optional development-only switch: EHS_MONITORING_MODE=disabled

# Production: replace the two Mock modes with production / enterprise and remove
# EHS_MOCK_* settings. Configure company identity, data, access, monitoring and
# notification adapters first; environment variables alone do not install adapters.
# Missing adapters fail closed. See docs/integration/corporate-ai-integration.md.
# Only during the approved one-time first-admin bootstrap; remove after completion.
EHS_BOOTSTRAP_PRINCIPAL_ID=
