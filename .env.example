# Local development only. Copy to .env.local.
# These Mock settings are not a production deployment configuration.
EHS_DATA_SOURCE=mock
EHS_IDENTITY_MODE=mock
EHS_MOCK_PROFILE=performance
EHS_MOCK_USER_EMAIL=admin@example.test
EHS_MOCK_USER_NAME="Waner Shangguan（上官婉儿）"
# Optional avatar URL; leave empty to retain the existing avatar fallback.
EHS_MOCK_USER_AVATAR_URL=

# Optional: exact trusted parent origin for enterprise embedding (scheme + host + port).
# Leave empty for standalone development. Never use a wildcard.
NEXT_PUBLIC_GLIFE_PARENT_ORIGIN=

# Production: replace the two Mock modes with production / enterprise and remove
# EHS_MOCK_* settings. Configure company identity, data and access adapters first; environment variables alone do not install adapters.
# Missing adapters fail closed. See docs/integration/corporate-ai-integration.md.
# Only during the approved one-time first-admin bootstrap; remove after completion.
EHS_BOOTSTRAP_PRINCIPAL_ID=
